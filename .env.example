# Copy to .env and fill in local/deployment values.
# Never commit a real .env file.

# PostgreSQL connection string used by SQLAlchemy
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# Optional direct PostgreSQL URL for running Alembic migrations (e.g. use
# the provider's direct URL instead of a pooled runtime URL).
NEON_DIRECT_URL=

# JWT signing configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Optional: comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Path to model artifacts (local default; container uses /app/ml/models)
MODEL_DIR=./ml/models

# Risk classification thresholds as probabilities, independent of action policy.
# Initial bands: LOW < 0.30, MEDIUM [0.30, 0.70), HIGH >= 0.70.
# Evaluate/calibrate with validation data, fraud prevalence, costs, and review capacity.
RISK_LOW_THRESHOLD=0.30
RISK_HIGH_THRESHOLD=0.70

# SMTP settings for human-review email. Keep passwords only in your private
# project-root .env; for Gmail, use an app password rather than your login.
# Gmail SMTP defaults; set your Gmail address and Google App Password locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_STARTTLS=true
FRONTEND_BASE_URL=http://localhost:5173

# Used only by docker-compose for the local Postgres service
DOCKER_POSTGRES_PASSWORD=

# Optional direct Neon URL for admin/migration tooling
NEON_DIRECT_URL=

# Optional external AI tooling (not required by the fraud API runtime)
# GEMINI_API_KEY=
